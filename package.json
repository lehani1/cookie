{
  "name": "cookie",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev --hostname 0.0.0.0",
    "build": "bun --bun next build",
    "package": "bun run build && bun scripts/package.mjs",
    "version": "bun scripts/version.mjs",
    "start": "bun --bun next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "postinstall": "bun scripts/copy-pdf-worker.mjs",
    "test": "python3 tests/create-fixtures.py && playwright test"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "epubjs": "^0.3.93",
    "pdfjs-dist": "^5.4.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
